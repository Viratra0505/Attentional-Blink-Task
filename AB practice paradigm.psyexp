        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="WELCOME TO THE PRACTICE TASK!!&amp;#10;&amp;#10;In this task, you will see a rapid sequence of flashing letters presented at the center of the screen.Interspersed among the letters, two NUMBERS (digits between 2 and 9) will appear.&amp;#10;&amp;#10;YOUR TASK:&amp;#10;1. Pay close attention to the entire stream.&amp;#10;2. Remember the FIRST number .&amp;#10;3. Remember the SECOND number .&amp;#10;&amp;#10;After each stream ends, you will be prompted to type both numbers in the exact order they appeared using your keyboard.Maintain your focus on the central fixation cross (+) throughout the task.&amp;#10;&amp;#10;Press the SPACEBAR when you are ready to begin." valType="str" updates="constant" name="text"/>
        <Param val="height" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1.3" valType="num" updates="constant" name="wrapWidth"/>
